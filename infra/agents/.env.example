# Copy to infra/agents/.env (gitignored) and fill in. swarm.sh loads it.
# DigitalOcean model access key (starts with doo-v1-)
HARNESS_INFERENCE_API_KEY=
# GitHub fine-grained token for JoshuaTT/Latice:
# Contents, Pull requests, Issues = read/write. No Administration, no Workflows.
GITHUB_TOKEN=

# --- Local agents (adapter "local" in swarm.conf) ---
# By default, local agents use your Claude Code login (claude auth login).
# To bill an Anthropic Console API key instead, set it here:
LOCAL_ANTHROPIC_API_KEY=
# Optional per-run spending cap for local agents, in USD (API-key billing only):
LOCAL_MAX_BUDGET_USD=
# Optional: where local agents' workspaces live (default: ~/lattice-swarm)
LATTICE_LOCAL_HOME=
