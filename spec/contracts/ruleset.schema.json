{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice.game/contracts/ruleset.schema.json",
  "title": "Lattice ruleset",
  "description": "Schema for a ruleset file. Instances are a ruleset TOML file (spec/rulesets/*.toml) parsed to JSON: TOML tables become JSON objects, TOML keys become the property names used here, integers stay integers, and '45 s' style values are stored as integer seconds. Every game parameter lives here and is read at runtime (AGENTS.md golden rule 4). Scalar tunables are plain numbers bounded by the exploration range from game-design §14.2 where the doc gives one, otherwise default-only. Parameters that scale with board size (game-design §4.0) use the uniform representation { base, formula }: 'base' is the integer base value from the doc and 'formula' is a string over the single variable s (board side length / 64) using the operators +, -, *, /, sqrt, log2, evaluated by the engine; the formula MUST reproduce the doc's scaling (e.g. \"base * sqrt(s)\", \"base * s\", \"2 + log2(s)\"). The 'structural' table holds parameters the tuning system must never auto-promote (system-design §6.3); tunables must not appear there. 'mutators' names the §6 pool and 'mutator_draw' the per-match draw count.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Ruleset version (semantic). Every match records its ruleset version (system-design §2.4)."
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epochs_per_match": { "type": "integer", "minimum": 3, "maximum": 6, "default": 4 },
        "beats_per_council": { "type": "integer", "minimum": 10, "maximum": 24, "default": 16 },
        "beat_length_seconds": { "type": "integer", "minimum": 20, "maximum": 120, "default": 45, "description": "Set by latency class (game-design §3.3)." },
        "charge_bank_cap": { "type": "integer", "minimum": 2, "maximum": 5, "default": 3 }
      },
      "required": ["epochs_per_match", "beats_per_council", "beat_length_seconds", "charge_bank_cap"]
    },
    "muster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opening_tokens": { "type": "integer", "minimum": 300, "maximum": 800, "default": 500 },
        "reply_tokens": { "type": "integer", "minimum": 100, "maximum": 300, "default": 200 }
      },
      "required": ["opening_tokens", "reply_tokens"]
    },
    "bandwidth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "personal_tokens": { "type": "integer", "minimum": 400, "maximum": 1500, "default": 800 },
        "shared_pool_tokens": { "type": "integer", "minimum": 1500, "maximum": 6000, "default": 3000 }
      },
      "required": ["personal_tokens", "shared_pool_tokens"]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team_complexity_nodes": { "type": "integer", "minimum": 1500, "maximum": 4000, "default": 2400 },
        "transfer_loss_percent": { "type": "integer", "minimum": 0, "maximum": 40, "default": 20 },
        "sim_credits": { "type": "integer", "minimum": 10, "maximum": 25, "default": 15 }
      },
      "required": ["team_complexity_nodes", "transfer_loss_percent", "sim_credits"]
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "side_length": { "type": "integer", "minimum": 64, "maximum": 2048, "default": 64, "description": "Bounds are the §14.2 exploration range; the doc's live range is 64–1024." },
        "core_hp": { "type": "integer", "default": 200 },
        "core_firewall": { "type": "integer", "default": 40 },
        "drone_hp": { "type": "integer", "default": 10 },
        "drone_firewall": { "type": "integer", "default": 3 }
      },
      "required": ["side_length", "core_hp", "core_firewall", "drone_hp", "drone_firewall"]
    },
    "scaling": {
      "type": "object",
      "description": "Board-size scaling parameters (game-design §4.0), each as { base, formula } over s = side_length / 64.",
      "additionalProperties": false,
      "properties": {
        "clash_length_ticks": { "$ref": "#/$defs/scaled", "default": { "base": 2000, "formula": "base * sqrt(s)" } },
        "clash_length_base": { "type": "integer", "minimum": 1000, "maximum": 4000, "default": 2000, "description": "Exploration range for the clash-length base (game-design §14.2 'Clash length')." },
        "drone_cap": { "$ref": "#/$defs/scaled", "default": { "base": 60, "formula": "base * sqrt(s)" } },
        "drone_cap_base": { "type": "integer", "minimum": 20, "maximum": 150, "default": 60 },
        "wells": { "$ref": "#/$defs/scaled", "default": { "base": 6, "formula": "base * s" } },
        "neutral_forges": { "$ref": "#/$defs/scaled", "default": { "base": 2, "formula": "base * s" } },
        "relics": { "$ref": "#/$defs/scaled", "default": { "base": 2, "formula": "base + log2(s)" } },
        "starting_energy": { "$ref": "#/$defs/scaled", "default": { "base": 400, "formula": "base * sqrt(s)" } },
        "starting_energy_base": { "type": "integer", "minimum": 200, "maximum": 800, "default": 400 },
        "intel_shards": { "type": "integer", "const": 5, "default": 5 },
        "fuel_per_tick": { "type": "integer", "minimum": 300, "maximum": 3000, "default": 1000 }
      },
      "required": ["clash_length_ticks", "drone_cap", "wells", "neutral_forges", "relics", "starting_energy", "intel_shards", "fuel_per_tick"]
    },
    "score_weights": {
      "type": "object",
      "description": "Weights from the §13 score formula.",
      "additionalProperties": false,
      "properties": {
        "owned_cells": { "type": "integer", "default": 1 },
        "wells_held": { "type": "integer", "default": 15 },
        "relics_held": { "type": "integer", "default": 60 },
        "remaining_core_hp": { "type": "integer", "default": 1 },
        "live_drones": { "type": "integer", "default": 3 }
      },
      "required": ["owned_cells", "wells_held", "relics_held", "remaining_core_hp", "live_drones"]
    },
    "structural": {
      "type": "object",
      "description": "Parameters the tuning system must never auto-promote (system-design §6.3). Only structural parameters belong here.",
      "additionalProperties": false,
      "properties": {
        "team_size": { "type": "integer", "const": 5, "default": 5 },
        "quorum": { "type": "integer", "minimum": 3, "maximum": 4, "default": 3, "description": "Signatures of team_size required to deploy (game-design §9.5)." },
        "win_conditions": {
          "type": "array",
          "items": { "enum": ["core_destroyed", "core_captured", "score_after_final_epoch"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["core_destroyed", "core_captured", "score_after_final_epoch"]
        }
      },
      "required": ["team_size", "quorum", "win_conditions"]
    },
    "mapgen": {
      "type": "object",
      "description": "Map generation constraints (spec/mapgen.md sections 2 to 4). Optional until the ruleset loader reads it; spec/mapgen.md holds the default for every key.",
      "additionalProperties": false,
      "properties": {
        "wall_density_min_percent": { "type": "integer", "minimum": 0, "maximum": 50, "default": 8, "description": "Fewest wall cells, as a percent of the board." },
        "wall_density_max_percent": { "type": "integer", "minimum": 0, "maximum": 50, "default": 18, "description": "Most wall cells, as a percent of the board." },
        "min_corridor_width": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2, "description": "Narrowest passage, in cells, between any two walls on a route between objectives." },
        "core_clearance_radius": { "type": "integer", "minimum": 1, "maximum": 4, "default": 2, "description": "Chebyshev radius around each Core centre that must be open (2 = a 5x5 square)." },
        "core_min_separation_percent": { "type": "integer", "minimum": 50, "maximum": 100, "default": 50, "description": "Minimum Chebyshev distance between the two Core centres, as a percent of the side length (game-design 4.0: at least half the board)." },
        "start_forge_min_distance": { "type": "integer", "minimum": 3, "maximum": 8, "default": 3, "description": "Nearest a team's starting Forge may be to its Core centre (Chebyshev)." },
        "start_forge_max_distance": { "type": "integer", "minimum": 3, "maximum": 12, "default": 6, "description": "Farthest a team's starting Forge may be from its Core centre (Chebyshev)." },
        "object_min_spacing": { "type": "integer", "minimum": 2, "maximum": 16, "default": 6, "description": "Minimum Chebyshev distance between any two of: Wells, Relics, neutral Forges, starting Forges." },
        "object_core_min_distance": { "type": "integer", "minimum": 4, "maximum": 24, "default": 8, "description": "Minimum Chebyshev distance from any Well, Relic or neutral Forge to either Core centre." },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 64, "default": 16, "description": "Generation attempts (reseeding on a failed fairness check) before generation fails." }
      },
      "required": ["wall_density_min_percent", "wall_density_max_percent", "min_corridor_width", "core_clearance_radius", "core_min_separation_percent", "start_forge_min_distance", "start_forge_max_distance", "object_min_spacing", "object_core_min_distance", "max_attempts"]
    },
    "mutators": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "description": "Numeric parameters of the game-design 6 mutators (spec/mapgen.md section 6). Optional until the ruleset loader reads it.",
          "additionalProperties": false,
          "properties": {
            "fog_sense_cap": { "type": "integer", "minimum": 1, "maximum": 8, "default": 3 },
            "costly_spawn_multiplier": { "type": "integer", "minimum": 2, "maximum": 5, "default": 3 },
            "quiet_radio_range": { "type": "integer", "minimum": 1, "maximum": 7, "default": 3 },
            "small_board_keys": { "type": "integer", "minimum": 4, "maximum": 63, "default": 16 },
            "glass_core_firewall": { "type": "integer", "minimum": 1, "maximum": 39, "default": 15 },
            "plague_hack_cost_percent": { "type": "integer", "minimum": 10, "maximum": 90, "default": 50 },
            "thin_air_fuel_percent": { "type": "integer", "minimum": 10, "maximum": 90, "default": 50 },
            "drift_percent": { "type": "integer", "minimum": 1, "maximum": 20, "default": 1 },
            "long_night_ticks": { "type": "integer", "minimum": 2001, "maximum": 16000, "default": 4000 },
            "banned_call_candidates": {
              "type": "array",
              "description": "Library function names one of which Banned Call disables. Filled from the lattice API reference (#38); while empty, Banned Call is removed from the draw.",
              "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_.]*$" },
              "uniqueItems": true,
              "default": []
            }
          },
          "required": ["fog_sense_cap", "costly_spawn_multiplier", "quiet_radio_range", "small_board_keys", "glass_core_firewall", "plague_hack_cost_percent", "thin_air_fuel_percent", "drift_percent", "long_night_ticks", "banned_call_candidates"]
        },
        "pool": {
          "type": "array",
          "items": {
            "enum": ["Fog", "Costly Spawn", "Quiet Radio", "Small Board", "Glass Core", "Plague", "Thin Air", "Banned Call", "Drift", "Long Night"]
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "The game-design §6 mutator pool. A match draws mutator_draw of these."
        },
        "draw_count": { "type": "integer", "minimum": 2, "maximum": 3, "default": 2, "description": "A match draws 2–3 mutators (game-design §6)." }
      },
      "required": ["pool", "draw_count"]
    }
  },
  "required": ["version", "match", "muster", "bandwidth", "quota", "board", "scaling", "score_weights", "structural", "mutators"],
  "$defs": {
    "scaled": {
      "type": "object",
      "description": "Uniform base+formula representation for board-scaling parameters (game-design §4.0). s = side_length / 64.",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "formula": { "type": "string", "enum": ["base * sqrt(s)", "base * s", "base + log2(s)"] }
      },
      "required": ["base", "formula"]
    }
  }
}
